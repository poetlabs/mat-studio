{
 "manifest_version": 3,
 "name": "Logo Mat Studio",
 "version": "1.0.0",
 "description": "Reads sketch orders from the design portal, designs the mat, and saves the .ai and .wmf files.",
 "action": {
  "default_title": "Logo Mat Studio",
  "default_icon": {
   "16": "icons/16.png",
   "32": "icons/32.png",
   "48": "icons/48.png"
  }
 },
 "icons": {
  "16": "icons/16.png",
  "48": "icons/48.png",
  "128": "icons/128.png"
 },
 "background": {
  "service_worker": "bg.js"
 },
 "permissions": [
  "downloads",
  "storage",
  "alarms",
  "tabs"
 ],
 "host_permissions": [
  "https://designupload.logomatsllc.com/*",
  "https://live.mtapi.biz/*",
  "https://*.amazonaws.com/*"
 ],
 "content_scripts": [
  {
   "matches": [
    "https://designupload.logomatsllc.com/Design/*"
   ],
   "js": [
    "content.js"
   ],
   "run_at": "document_idle"
  }
 ]
}